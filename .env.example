# ============================================================================
# FORGEPOINT LOCAL DEV ENVIRONMENT VARIABLES
# ============================================================================
#
# Copy this file to .env and fill in values for local development.
# The .env file is git-ignored — NEVER commit real credentials.
#
# Usage:
#   cp .env.example .env
#   # edit .env with your values
#   make up
#
# If .env is absent, docker-compose uses the defaults shown here (via ${VAR:-default}).
# The defaults are PUBLISHED dev values. They are acceptable only because every
# port binds to 127.0.0.1 (see FP_BIND_ADDR below). Replace every *_PASSWORD
# before binding to anything else.
#
# ============================================================================

# ----------------------------------------------------------------------------
# NETWORK EXPOSURE
# ----------------------------------------------------------------------------
# Address every published port binds to. With a REMOTE docker engine (docker
# context over ssh) this address is on the engine host, not your laptop, and
# 0.0.0.0 there means its LAN and VPN interfaces. Prefer an ssh tunnel
# (ssh -L 6379:127.0.0.1:6379 <engine-host>) over changing this.
FP_BIND_ADDR=127.0.0.1

# ----------------------------------------------------------------------------
# POSTGRES
# ----------------------------------------------------------------------------
# Password for the fp database user. Services connect as:
#   postgres://fp:${POSTGRES_PASSWORD}@localhost:5432/fp_{service}
POSTGRES_PASSWORD=fp

# ----------------------------------------------------------------------------
# MINIO (S3-compatible object storage)
# ----------------------------------------------------------------------------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# ----------------------------------------------------------------------------
# REDIS / NATS (both require auth)
# ----------------------------------------------------------------------------
# The Go services' local defaults use these same dev values:
#   FP_REDIS_URL=redis://:${REDIS_PASSWORD}@localhost:6379
#   FP_NATS_URL=nats://fp:${NATS_PASSWORD}@localhost:4222
# If you change a password here, export the matching FP_* URL before `go run`.
REDIS_PASSWORD=fp
NATS_PASSWORD=fp

# ----------------------------------------------------------------------------
# GRAFANA
# ----------------------------------------------------------------------------
# Admin password for the Grafana UI (http://localhost:3000).
# Anonymous read-only access is also enabled for browsing dashboards.
GRAFANA_ADMIN_PASSWORD=admin

# ----------------------------------------------------------------------------
# APPLICATION
# ----------------------------------------------------------------------------
# Set to "production" to enable production-only guards (e.g. MemoryProcessedStore
# panics, stricter TLS). Leave unset or set to "development" for local dev.
# FP_ENV=development
