# ============================================================================
# dev — EXAMPLE TFVARS
# ============================================================================
# Copy to terraform.tfvars (gitignored) and tune. Sizing values match the
# defaults in variables.tf. The DESTRUCTIVE switches (deletion protection off,
# no final snapshot, force-delete, immediate secret deletion) do NOT: their
# defaults are the safe values, and this file opts a throwaway dev env into
# them. There are NO secrets here: the Postgres password is managed by RDS and
# the Redis token is generated by Terraform into Secrets Manager.
# ----------------------------------------------------------------------------

environment = "dev"
aws_region  = "us-east-1"

# ---- Networking ------------------------------------------------------------
vpc_cidr           = "10.0.0.0/16"
az_count           = 3
single_nat_gateway = true # PROD: false (one NAT per AZ for egress resilience)

# ---- EKS -------------------------------------------------------------------
cluster_version = "1.30"
# Kubernetes API endpoint. Same secure default as variables.tf: private only,
# reached from inside the VPC (bastion / VPN / SSM port-forward).
eks_public_access       = false
eks_public_access_cidrs = []
# Need kubectl from a laptop on a throwaway cluster? Enable the public endpoint
# AND restrict it to your own egress IP (curl -s https://checkip.amazonaws.com):
#   eks_public_access       = true
#   eks_public_access_cidrs = ["203.0.113.10/32"]
# Never 0.0.0.0/0: that puts the API server on the internet, guarded only by
# authentication. (Trivy does not scan *.tfvars.example files, so nothing in CI
# would have caught this file doing exactly that.)

node_instance_types = ["t3.medium"]
node_desired_size   = 2
node_min_size       = 2
node_max_size       = 4
node_capacity_type  = "ON_DEMAND" # DEV money-saver: "SPOT" (~70% cheaper)

# ---- RDS (PostgreSQL) ------------------------------------------------------
rds_instance_class        = "db.t3.micro"
rds_engine_version        = "16.4"
rds_multi_az              = false # PROD: true
rds_deletion_protection   = false # PROD: true (the variable default)
rds_skip_final_snapshot   = true  # PROD: false (the variable default)
rds_backup_retention_days = 7     # PROD: 14-35

# ---- ElastiCache (Redis) ---------------------------------------------------
redis_node_type          = "cache.t3.micro"
redis_engine_version     = "7.1"
redis_num_nodes          = 1     # PROD: >= 2
redis_automatic_failover = false # PROD: true (needs redis_num_nodes >= 2)

# ---- Cost guardrail (budget_alert_emails is REQUIRED) -----------------------
budget_monthly_limit_usd = 250
budget_alert_emails      = ["you@example.com"]

# ---- Throwaway-env teardown switches ----------------------------------------
# These make `terraform destroy` fast and complete for a disposable dev env. The
# variable defaults are the SAFE values; delete these lines for anything that
# holds data you care about.
secret_recovery_window_days = 0    # PROD: 7-30 (default 30)
ecr_force_delete            = true # PROD: false (the default)
