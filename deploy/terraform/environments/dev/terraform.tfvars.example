# ============================================================================
# dev — EXAMPLE TFVARS
# ============================================================================
# Copy to terraform.tfvars (gitignored) and tune. Every value here already has a
# sensible dev default in variables.tf, so this file is OPTIONAL — it exists to
# show the knobs and document how prod would differ. There are NO secrets here:
# DB/Redis credentials are generated by Terraform into Secrets Manager.
# ----------------------------------------------------------------------------

environment = "dev"
aws_region  = "us-east-1"

# ---- Networking ------------------------------------------------------------
vpc_cidr           = "10.0.0.0/16"
az_count           = 3
single_nat_gateway = true # PROD: false (one NAT per AZ for egress resilience)

# ---- EKS -------------------------------------------------------------------
cluster_version   = "1.30"
eks_public_access = true # PROD: false (reach the API via VPN/bastion only)
# SECURITY: replace with your office/VPN egress CIDR. 0.0.0.0/0 = open to the world.
eks_public_access_cidrs = ["0.0.0.0/0"]

node_instance_types = ["t3.medium"]
node_desired_size   = 2
node_min_size       = 2
node_max_size       = 4
node_capacity_type  = "ON_DEMAND" # DEV money-saver: "SPOT" (~70% cheaper)

# ---- RDS (PostgreSQL) ------------------------------------------------------
rds_instance_class        = "db.t3.micro"
rds_engine_version        = "16.4"
rds_multi_az              = false # PROD: true
rds_deletion_protection   = false # PROD: true
rds_backup_retention_days = 7     # PROD: 14-35

# ---- ElastiCache (Redis) ---------------------------------------------------
redis_node_type          = "cache.t3.micro"
redis_engine_version     = "7.1"
redis_num_nodes          = 1     # PROD: >= 2
redis_automatic_failover = false # PROD: true (needs redis_num_nodes >= 2)
