# ============================================================================
# dev — ENVIRONMENT VARIABLES
# ============================================================================
# Every knob the modules expose is surfaced here. Sizing defaults are DEV-sized
# (small + cheap). Anything DESTRUCTIVE (deletion protection off, no final
# snapshot, force-delete, immediate secret deletion) defaults to the SAFE value
# and the dev env opts in through terraform.tfvars, so a copy of this directory
# for staging/prod starts safe even if nobody copies the dev tfvars.
#
# Nothing secret lives here: DB/Redis credentials are GENERATED by Terraform and
# stored in Secrets Manager (see the rds/elasticache modules). No account IDs are
# hardcoded — where one is needed (bucket names) it's read from a data source at
# plan time.
# ============================================================================

variable "environment" {
  description = "Environment name — feeds the Environment tag and resource name prefixes. \"dev\" here; \"staging\"/\"prod\" in their copies."
  type        = string
  default     = "dev"
}

variable "aws_region" {
  description = "AWS region to deploy into. No region is hardcoded anywhere else — this single var drives the provider and all region-derived names (VPC endpoints, ECR URLs). Override per deployment."
  type        = string
  default     = "us-east-1"
}

# ---- Networking ------------------------------------------------------------
variable "vpc_cidr" {
  description = "VPC CIDR. /16 leaves ample room for pod IPs (VPC-CNI assigns real IPs)."
  type        = string
  default     = "10.0.0.0/16"
}

variable "az_count" {
  description = "AZs to span. 3 for HA even in dev (cost is mostly in NAT, which single_nat_gateway controls separately)."
  type        = number
  default     = 3
}

variable "single_nat_gateway" {
  description = "Dev: TRUE — one NAT gateway for all private subnets (saves ~$64/mo vs three). Prod: FALSE for per-AZ NAT resilience."
  type        = bool
  default     = true
}

# ---- EKS -------------------------------------------------------------------
variable "cluster_version" {
  description = "EKS Kubernetes version."
  type        = string
  default     = "1.30"
}

variable "eks_public_access" {
  description = "Expose the K8s API publicly (CIDR-restricted). SECURE DEFAULT: false — kubectl/helm must run from within the VPC (bastion or VPN). Set true in a personal throwaway dev cluster AND specify eks_public_access_cidrs to your egress IP. Never enable without restricting CIDRs."
  type        = bool
  default     = false
}

variable "eks_public_access_cidrs" {
  description = "CIDRs allowed to reach the public API endpoint when eks_public_access=true. SECURE DEFAULT: empty list (EKS interprets this as \"allow none\" when the public endpoint is disabled; when you enable the public endpoint set this to your VPN/office IP, e.g. [\"203.0.113.10/32\"]). NEVER set to [\"0.0.0.0/0\"] — that makes the Kubernetes API world-reachable, a critical CIS finding."
  type        = list(string)
  default     = []
}

variable "node_instance_types" {
  description = "Node group instance types. Dev: t3.medium."
  type        = list(string)
  default     = ["t3.medium"]
}

variable "node_desired_size" {
  description = "Desired node count (dev: 2)."
  type        = number
  default     = 2
}

variable "node_min_size" {
  description = "Min node count (dev: 2)."
  type        = number
  default     = 2
}

variable "node_max_size" {
  description = "Max node count (dev: 4)."
  type        = number
  default     = 4
}

variable "node_capacity_type" {
  description = "ON_DEMAND or SPOT. Dev can flip to SPOT to cut node cost ~70% (stateless, replicated services tolerate interruptions)."
  type        = string
  default     = "ON_DEMAND"
}

# ---- RDS (PostgreSQL) ------------------------------------------------------
variable "rds_instance_class" {
  description = "RDS instance class. Dev: db.t3.micro."
  type        = string
  default     = "db.t3.micro"
}

variable "rds_engine_version" {
  description = "PostgreSQL version."
  type        = string
  default     = "16.4"
}

variable "rds_multi_az" {
  description = "RDS multi-AZ standby. Dev: FALSE (cost). Prod: TRUE."
  type        = bool
  default     = false
}

variable "rds_deletion_protection" {
  description = "Block deletion of the DB. SAFE DEFAULT true. The dev tfvars sets false so the throwaway env can be torn down."
  type        = bool
  default     = true
}

variable "rds_skip_final_snapshot" {
  description = "Skip the final snapshot when the DB is deleted. SAFE DEFAULT false. The dev tfvars sets true so teardown is instant and free."
  type        = bool
  default     = false
}

variable "rds_backup_retention_days" {
  description = "Automated backup retention. Dev: 7."
  type        = number
  default     = 7
}

# ---- Cost guardrail ---------------------------------------------------------
variable "budget_monthly_limit_usd" {
  description = "Monthly cost budget in USD. This env idles at roughly $200-250/month (EKS control plane, NAT gateway, two t3.medium nodes, interface endpoints, RDS, ElastiCache, KMS keys), so the default leaves a little headroom; alerts fire at 50/80/100% of actual spend and at 100% of forecast."
  type        = number
  default     = 250
}

variable "budget_alert_emails" {
  description = "Email addresses that receive the budget alerts. REQUIRED, with no default: an environment that runs a NAT gateway and an EKS control plane must not be applyable without someone being told what it costs. AWS sends a confirmation email to each address once."
  type        = list(string)

  validation {
    condition     = length(var.budget_alert_emails) > 0
    error_message = "budget_alert_emails must list at least one address."
  }
}

# ---- Destructive teardown switches (safe defaults; dev opts in via tfvars) --
variable "secret_recovery_window_days" {
  description = "Recovery window for the Secrets Manager secrets Terraform creates (RDS connection info, Redis credentials): 7-30 days, or 0 to delete immediately. SAFE DEFAULT 30. The dev tfvars sets 0 so destroy + re-apply does not collide with a secret pending deletion."
  type        = number
  default     = 30
}

variable "ecr_force_delete" {
  description = "Let `terraform destroy` delete ECR repositories that still hold images. SAFE DEFAULT false. The dev tfvars sets true."
  type        = bool
  default     = false
}

# ---- ElastiCache (Redis) ---------------------------------------------------
variable "redis_node_type" {
  description = "ElastiCache node type. Dev: cache.t3.micro."
  type        = string
  default     = "cache.t3.micro"
}

variable "redis_engine_version" {
  description = "Redis engine version."
  type        = string
  default     = "7.1"
}

variable "redis_num_nodes" {
  description = "Cache nodes. Dev: 1 (no failover). Prod: >=2 with redis_automatic_failover=true."
  type        = number
  default     = 1
}

variable "redis_automatic_failover" {
  description = "Auto-promote a replica on primary failure. Requires redis_num_nodes>=2, so FALSE in single-node dev."
  type        = bool
  default     = false
}
