# ============================================================================
# Forgepoint Web UI — environment configuration (Vite)
# ============================================================================
# Only variables prefixed with VITE_ are exposed to the browser bundle. NEVER
# put a secret here: anything in here ships to the client. There are no secrets
# in this app — the JWT is obtained at runtime via POST /api/v1/login, not baked
# into the build.

# The Forgepoint BFF base URL the Vite DEV PROXY forwards "/api/*" to.
# Default matches the BFF's HTTP_PORT (8081). Reach a cluster BFF locally with:
#   kubectl -n fp-system port-forward svc/fp-bff 8081:8081
# In production the SPA is served same-origin with the BFF, so this is unused
# (the app always calls the relative path "/api/v1/...").
VITE_BFF_URL=http://localhost:8081
